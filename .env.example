FPL_CLASSIC_LEAGUE_ID=539533
FPL_H2H_LEAGUE_ID=539596

ADMIN_EMAIL=admin@fanhouse.local
ADMIN_PASSWORD=changeme

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-secret

# Neon — use the pooled connection for the app (ends with -pooler or has channel_binding)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon — direct (non-pooler) URL for prisma migrate / seed
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
